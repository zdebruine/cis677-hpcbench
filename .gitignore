__pycache__/
*.pyc
_site/
build/
work/
*.sif

# Raw corpora are regenerated from the packed matrices; keep them out of git.
data/*/public.bin
data/*/holdout.bin
data/*/*.bin
!data/*/*.npz

# A committed result.bin is the stale-result attack the gate tests exist to
# catch. It must never be in a repository.
result.bin
