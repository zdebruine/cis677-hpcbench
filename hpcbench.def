# Apptainer image: the pinned toolchain every submission is built against.
#   sudo apptainer build hpcbench.sif hpcbench.def
#
# Pinning matters more than it looks. A compiler upgrade mid-semester silently
# changes every timing on the leaderboard, and students would rightly conclude
# the numbers are meaningless. Build this once and do not rebuild it during
# the term.
Bootstrap: docker
From: ubuntu:24.04

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update && apt-get install -y --no-install-recommends \
        build-essential g++-13 gcc-13 cmake ninja-build git \
        libomp-dev libopenblas-dev \
        python3 python3-pip \
        linux-tools-common linux-tools-generic \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*
    update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-13 100
    update-alternatives --install /usr/bin/g++ g++ /usr/bin/g++-13 100

%environment
    export LC_ALL=C
    export OMP_PROC_BIND=close
    export OMP_PLACES=cores

%labels
    Course CIS 677
    Purpose Pinned build+measure environment for hpcbench

%help
    Build and measurement environment for CIS 677 submissions.
    GCC 13, CMake, OpenMP, OpenBLAS, perf, Python 3.
